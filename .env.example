# ShopSense settings.  To use:   copy .env.example .env   (Windows)   or   cp .env.example .env   (Mac/Linux), then edit .env.
# The project reads ./.env automatically when it starts (shopsense/envfile.py). A variable already set in your terminal wins over .env,
# and a blank value here is ignored. Never commit .env and never paste a real key into a chat.
#
# YOU ONLY NEED THE FIRST SECTION. Everything below it has a working default; it is listed so each knob is documented in one place,
# not because you have to set it.

# =====================================================================================================================
# 1. MINIMUM -- pick ONE of these three ways to run
# =====================================================================================================================
# (a) Live model, Groq (free tier): put your key here. The default model is groq/openai/gpt-oss-20b, the one every live test used,
#     so no model line is needed. Set SHOPSENSE_LLM_MODEL only to use a different one.
GROQ_API_KEY=
# SHOPSENSE_LLM_MODEL=groq/openai/gpt-oss-20b
#
# (b) Live model, Gemini (free tier): set the key and the model name instead.
# GEMINI_API_KEY=
# SHOPSENSE_LLM_MODEL=gemini/gemini-3.1-flash-lite
#
# (c) No key at all: offline demo mode. A keyword extractor and retrieval-only policy answer stand in for the model.
#     Everything else (routing, refund limits, approvals, guardrails, the API) is the real code. Never use for real customers.
# SHOPSENSE_OFFLINE=1

# =====================================================================================================================
# 2. OPTIONAL -- leave alone unless you know why. Defaults shown.
# =====================================================================================================================

# ---- model behaviour --------------------------------------------------------------------------------------------------
# SHOPSENSE_LLM_FALLBACK_MODELS=             # comma list tried in order if the primary fails; every use is logged and flags the ticket "degraded"
# SHOPSENSE_LLM_TIMEOUT_S=60                 # one hung call cannot stall a batch
# SHOPSENSE_LLM_MIN_INTERVAL=0               # seconds between model calls (free tiers: 4 keeps you under ~15 calls/min)
# SHOPSENSE_LLM_BREAKER_THRESHOLD=3          # consecutive exhausted calls before a model's circuit breaker opens
# SHOPSENSE_LLM_BREAKER_RESET_S=60           # cool-down before one trial call is allowed
# SHOPSENSE_SUPERVISOR_LLM=on                # off = the team supervisor skips its model call
# SHOPSENSE_EMBED_MODEL=                     # real embeddings, e.g. gemini/gemini-embedding-001 (needs GEMINI_API_KEY; Groq has no embeddings)
# SHOPSENSE_EMBED_BATCH=50                   # items per embedding call (Gemini caps at 100)

# ---- order-system guard (retries + circuit breaker + fallback to the human queue) --------------------------------------
# SHOPSENSE_ORDER_RETRIES=3
# SHOPSENSE_ORDER_BACKOFF_S=0.2
# SHOPSENSE_ORDER_BREAKER_THRESHOLD=3
# SHOPSENSE_ORDER_BREAKER_RESET_S=30

# ---- tracing (Milestone 7). Without LangFuse keys, traces still go to data/shopsense/traces/traces.jsonl ------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # https://us.cloud.langfuse.com for the US region
# LANGFUSE_HOST=                             # older name for LANGFUSE_BASE_URL; set only one of them
# SHOPSENSE_TRACING=1                        # 0 = off entirely
# SHOPSENSE_LANGFUSE=1                       # 0 = local trace file only even when keys are set
# SHOPSENSE_TRACE_FILE=                      # default data/shopsense/traces/traces.jsonl
# SHOPSENSE_TRACE_SAMPLE_RATE=1.0            # share of HEALTHY auto-resolved runs kept locally; failed/degraded/escalated runs are always kept
# SHOPSENSE_TRACE_SALT=change-me             # salts the one-way hash of customer ids in traces
# SHOPSENSE_PROMPT_VERSION=                  # tag stamped on every trace so a prompt change can be compared with the one before
# LANGFUSE_SAMPLE_RATE=1.0                   # keep at 1.0: the SDK's head sampling cannot know a run will fail

# ---- chat API (Milestone 8) ---------------------------------------------------------------------------------------------
# SHOPSENSE_API_DEADLINE_S=40                # most seconds ONE chat request may spend waiting on the model provider; then the ticket goes to a person. 0 = no limit
# SHOPSENSE_API_MEMO_TEAM=0                  # 1 = the 5-agent memo team also runs for escalated chats (~50 s of model calls; for a batch, not a chat reply)

# ---- MCP server and approvals (Milestone 6) -----------------------------------------------------------------------------
# SHOPSENSE_APPROVAL_SECRET=change-me        # signs MCP approval tokens -- CHANGE THIS outside a demo
# SHOPSENSE_MCP_ROLE=system                  # authority of the MCP server's writes (system < manager < executive)
# SHOPSENSE_ACTION_LEDGER=                   # default data/shopsense/workflow_state/actions.jsonl

# ---- storage and evaluation ---------------------------------------------------------------------------------------------
# SHOPSENSE_MEMORY_DIR=                      # default data/shopsense/memory
# SHOPSENSE_EVAL_PAUSE_S=2                   # seconds between cases in run_golden_eval.py --live (keeps free-tier budgets alive)

# ---- dotenv itself ------------------------------------------------------------------------------------------------------
# SHOPSENSE_NO_DOTENV=1                      # ignore .env entirely (the test suite sets this)
# SHOPSENSE_ENV_FILE=                        # read a different file instead of ./.env
